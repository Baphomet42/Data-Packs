execute at @s[tag=42.tag.xltt.odm.hit] run playsound entity.item.break block @a ~ ~ ~ .25 .25
function 42:xltt/match_id
tag @s add 42.tag.xltt.temp_find_target_marker
execute if entity @s[tag=42.tag.xltt.odm.hit] as @a[predicate=42:xltt/match_id] at @s run playsound entity.item.break block @s ~ ~ ~ .25 .25
execute if entity @s[tag=42.tag.xltt.odm.hit] as @e[tag=42.tag.xltt.odm.hit,predicate=42:xltt/match_id,tag=!42.tag.xltt.temp_find_target_marker] at @s run function 42:xltt/odm/break
tag @s remove 42.tag.xltt.temp_find_target_marker
